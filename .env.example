# Application Environment
NODE_ENV=development

# Web App Ports & URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8000

# Supabase Local or Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Analytics Service Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (Direct Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradelens

# AI Provider API Keys (Optional - Anthropic Claude, Google Gemini, Groq, or Free Deterministic Engine)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

GROQ_API_KEY=your-groq-api-key-here

